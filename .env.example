# ---- App ----
APP_BASE_URL=http://localhost:3000            # https://ricorsa.com in production
NEXT_PUBLIC_APP_NAME=Ricorsa
ADMIN_EMAILS=                                 # comma-separated; these accounts get every capability, no quotas, and a "demo as plan" switch

# ---- Auth0 (Regular Web Application) ----
AUTH0_DOMAIN=your-tenant.us.auth0.com         # no https://
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=                                 # openssl rand -hex 32

# ---- Database ----
# Cloudflare D1, bound as `DB` in wrangler.jsonc. Nothing to set here.
# Local: `npm run db:migrate:local` once, then `npm run dev` (data lives in .wrangler/state).

# ---- Anthropic (models and live web search) ----
KIMI_API_KEY=                                 # platform.moonshot.ai, API keys
KIMI_BASE_URL=https://api.moonshot.ai/v1
BRAVE_API_KEY=                                # api.search.brave.com, for live web results and citations
MODEL_QUICK=kimi-k2-turbo-preview
MODEL_DEFAULT=kimi-k2-0905-preview
MODEL_COMPLEX=kimi-k2-thinking
# WEB_SEARCH_TOOL=web_search_20260318         # server tool version; older versions are tried automatically if rejected

# ---- PayPal (Business account, REST app) ----
PAYPAL_ENV=sandbox                            # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                            # printed by `npm run paypal:webhook` or copied from the dashboard
PAYPAL_PLAN_PRO=                              # written by `npm run paypal:setup`
PAYPAL_PLAN_TEAM=                             # written by `npm run paypal:setup`

# ---- Dev-only conveniences (ignored in production builds) ----
# DEV_FAKE_USER=1        # skip Auth0 locally and act as a fixed dev user
# DEV_MOCK_LLM=1         # stream a canned answer instead of calling Anthropic

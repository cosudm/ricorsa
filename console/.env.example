# ---- App ----
APP_NAME=SMEPro Ricorsa Manager Console
APP_BASE_URL=http://localhost:3124            # https://manage.ricorsa.com in production
PRODUCT_URL=https://ricorsa.com
CONSOLE_OWNERS=                               # comma-separated emails that are owners of the console

# ---- Auth0 (Regular Web Application, same tenant as Ricorsa, its own application) ----
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=                                 # openssl rand -hex 32

# ---- Databases ----
# Cloudflare D1: `DB` (the console's own) and `RICORSA` (the product's) in wrangler.jsonc. Nothing to set here.
# Local: `npm run db:migrate:local` once, then `npm run dev` (data lives in .wrangler/state).

# ---- PayPal invoicing (the same Business app as the product) ----
PAYPAL_ENV=sandbox                            # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM=Ricorsa <hello@ricorsa.com>

# ---- Dev-only conveniences (ignored in production builds) ----
# DEV_FAKE_USER=1        # skip Auth0 locally and act as a fixed owner
# DEV_FAKE_EMAIL=you@example.com
